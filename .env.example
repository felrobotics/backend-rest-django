# Every environment variable the app uses, with SAFE DUMMY values.
# Local:  cp .env.example .env   (.env is gitignored; never commit it)
# AWS:    the same names are injected from Secrets Manager / SSM Parameter Store.

# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
# Comma-separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
# Used by the local `db` container to create the database and user.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Used by Django (django-environ). Keep in sync with the three values above.
DATABASE_URL=postgres://app:app@db:5432/app

# --- Redis / Celery -----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- gunicorn (prod target only) ---------------------------------------------
WEB_CONCURRENCY=2

# --- S3 media storage (production only; leave empty locally) ------------------
# No access keys: in AWS the task's IAM role provides credentials.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- docker compose: build-time user mapping ---------------------------------
# Set to your `id -u` / `id -g` if they aren't 1000.
APP_UID=1000
APP_GID=1000
